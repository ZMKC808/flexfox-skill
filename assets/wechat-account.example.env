# Copy to config/wechat.local.env and fill locally. Never commit the copied file.
FLEXFOX_WECHAT_APPID=
FLEXFOX_WECHAT_APPSECRET=
FLEXFOX_WECHAT_AUTHOR=
FLEXFOX_WECHAT_SHOW_COVER_PIC=0
# Set to 1 only for an account that should draft automatically after local layout rendering.
FLEXFOX_WECHAT_AUTO_DRAFT=0
# Optional account-specific opening GIF. Keep the local source and generated URL out of Git.
FLEXFOX_WECHAT_INTRO_GIF_PATH=
FLEXFOX_WECHAT_INTRO_GIF_URL=
